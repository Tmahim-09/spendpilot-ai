# ==============================================================================
# SpendPilot AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# For Vercel deployments, configure these variables in:
#   Project Settings -> Environment Variables
#
# NOTE: Never commit .env.local or any real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini AI Shopping Intelligence (Server-Only)
# ------------------------------------------------------------------------------
# Required: Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional: Primary Gemini model (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: Comma-separated list of fallback models on transient capacity spikes
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash

# ------------------------------------------------------------------------------
# 2. Channel3 Product Discovery API (Server-Only)
# ------------------------------------------------------------------------------
# Required: Channel3 API key from Channel3 Portal (https://trychannel3.com/)
# Used for real-time multi-merchant catalog queries and live offer pricing
CHANNEL3_API_KEY=

# ------------------------------------------------------------------------------
# 3. PayPal Multi-Seller Sandbox Configuration
# ------------------------------------------------------------------------------
# IMPORTANT SECURITY NOTICE:
# SpendPilot's multi-seller demonstration is strictly restricted to PayPal Sandbox.
# Live PayPal credentials and live payment processing are strictly forbidden.

# Required (Client-Exposed): PayPal Sandbox REST App Client ID for frontend SDK loading.
# This variable is public by design; it MUST ONLY contain your Sandbox Client ID.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Required (Server-Only): PayPal Sandbox REST App Client ID for backend API calls.
# Must match NEXT_PUBLIC_PAYPAL_CLIENT_ID.
PAYPAL_CLIENT_ID=

# Required (Server-Only): PayPal Sandbox REST App Secret.
# Never expose this secret to client-side code.
PAYPAL_CLIENT_SECRET=

# Required (Server-Only): Dedicated cryptographic secret for HMAC-signing checkout tokens.
# Must be a secure random string (minimum 32 characters).
# Example generator: openssl rand -hex 32
PAYPAL_CHECKOUT_SIGNING_SECRET=

# Required (Server-Only): Must remain 'sandbox'. Live environments are strictly rejected.
PAYPAL_ENV=sandbox

# Required (Server-Only): Must remain 'https://api-m.sandbox.paypal.com'.
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 4. PayPal Demo Business Sellers (Two-Seller Demonstration)
# ------------------------------------------------------------------------------
# SpendPilot demonstrates one buyer approval with separate purchase units for independent merchants.
# These must be two distinct Sandbox Business seller accounts eligible for PayPal
# multi-seller / marketplace payments and connected to your platform.
# They are demo sellers for the fixed sample catalog, NOT retailer IDs from Channel3.
# Obtain Sandbox Merchant IDs from developer.paypal.com -> Sandbox Accounts.

# Required for demo checkout (Server-Only): Demo Seller A (SpendPilot Audio Lab)
PAYPAL_DEMO_SELLER_A_MERCHANT_ID=
# Optional (Server-Only): Demo Seller A Sandbox email
PAYPAL_DEMO_SELLER_A_EMAIL=

# Required for demo checkout (Server-Only): Demo Seller B (SpendPilot Workspace Gear)
PAYPAL_DEMO_SELLER_B_MERCHANT_ID=
# Optional (Server-Only): Demo Seller B Sandbox email
PAYPAL_DEMO_SELLER_B_EMAIL=

# ------------------------------------------------------------------------------
# 5. Optional PayPal Partner Attribution (BN Code)
# ------------------------------------------------------------------------------
# Optional (Server-Only): PayPal Partner Attribution ID (Build Notation code)
PAYPAL_PARTNER_ATTRIBUTION_ID=
