# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite

# Channel3 Product Discovery API
CHANNEL3_API_KEY=

# PayPal Multi-Seller Sandbox Configuration
# Authorized PayPal Sandbox REST Application
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CHECKOUT_SIGNING_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Demo Seller A (e.g. SpendPilot Audio Lab)
PAYPAL_DEMO_SELLER_A_MERCHANT_ID=
PAYPAL_DEMO_SELLER_A_EMAIL=

# Demo Seller B (e.g. SpendPilot Workspace Gear)
PAYPAL_DEMO_SELLER_B_MERCHANT_ID=
PAYPAL_DEMO_SELLER_B_EMAIL=

# Optional PayPal Partner Attribution ID (BN Code)
PAYPAL_PARTNER_ATTRIBUTION_ID=
